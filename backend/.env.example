PORT=5000
MONGODB_URI=mongodb://localhost:27017/tritech_hub
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Field Encryption (for PII: phone, Ghana card numbers)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=Dan & Dor Solar Company Ltd. <your_gmail@gmail.com>

# Paystack
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# ── Android lock agent (Device Owner app) ──
# Public URL of THIS backend (used in the provisioning QR the phone enrolls with).
PUBLIC_BACKEND_URL=https://tritechhub.online
# Android package + device-admin receiver of the lock agent app.
AGENT_PACKAGE=com.dandorsolar.lockagent
# Must match the receiver class in the agent's AndroidManifest.xml.
AGENT_RECEIVER=com.dandorsolar.lockagent/.LockDeviceAdminReceiver
# OPTIONAL. By default the agent APK is served from this app's own
# /downloads/dandorsolar-lock-agent.apk and the checksum is read from the
# committed backend/downloads/agent-checksum.txt (the build publishes both),
# so you normally leave these blank. Override only to host the APK elsewhere.
AGENT_APK_URL=
AGENT_APK_CHECKSUM=
# How often the agent polls when FCM is unavailable (seconds).
AGENT_POLL_SECONDS=900
BUSINESS_NAME=Dan & Dor Solar Company Ltd.
BUSINESS_PHONE=

# Firebase Cloud Messaging — OPTIONAL. Enables INSTANT lock/unlock push.
# Without it, locks still apply on the agent's next poll (~15 min).
# Paste the whole service-account JSON on one line, OR set the three fields.
FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# (Legacy iOS — no longer used after the Android pivot)
SIMPLEMDM_API_KEY=your_simplemdm_api_key

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
