{
  "name": "tritech-hub-frontend",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:cap": "vite build --config vite.config.cap.js --mode capacitor",
    "cap:sync": "npm run build:cap && npx cap sync",
    "cap:ios": "npm run build:cap && npx cap sync ios && npx cap open ios",
    "cap:android": "npm run build:cap && npx cap sync android && npx cap open android",
    "cap:desktop": "npm run build:cap && npx cap sync @capacitor-community/electron && cd electron && npm install && npm start"
  },
  "dependencies": {
    "@capacitor-community/electron": "^5.0.1",
    "@capgo/capacitor-updater": "^8.51.2",
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@paystack/inline-js": "^2.22.9",
    "axios": "^1.6.2",
    "date-fns": "^2.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.20.1",
    "react-webcam": "^7.2.0",
    "recharts": "^2.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^6.0.3",
    "vite": "^5.0.5"
  }
}
