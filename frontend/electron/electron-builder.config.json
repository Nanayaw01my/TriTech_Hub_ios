{
  "appId": "com.tritechhub.app",
  "productName": "TriTech Hub",
  "directories": {
    "buildResources": "resources",
    "output": "release"
  },
  "files": [
    "assets/**/*",
    "build/**/*",
    "capacitor.config.*",
    "app/**/*"
  ],
  "publish": null,
  "nsis": {
    "allowElevation": true,
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "assets/appIcon.ico",
    "shortcutName": "TriTech Hub"
  },
  "win": {
    "target": "zip",
    "icon": "assets/appIcon.ico",
    "sign": false
  },
  "mac": {
    "category": "public.app-category.business",
    "target": "dmg",
    "icon": "assets/appIcon.png"
  },
  "linux": {
    "target": "AppImage",
    "icon": "assets/appIcon.png",
    "category": "Office"
  }
}
